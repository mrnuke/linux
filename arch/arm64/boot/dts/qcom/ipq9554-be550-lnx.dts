/dts-v1/;

#include "ipq9574.dtsi"
#include "ipq9574-ess.dtsi"

#include <dt-bindings/gpio/gpio.h>

/ {
	model = "TP_Link BE550";
	compatible = "tplink,be550", "qcom,ipq9574";

	aliases {
		serial0 = &blsp1_uart2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&mdio {
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	phy-reset-gpio = <&tlmm 60 GPIO_ACTIVE_HIGH>,
			 <&tlmm 36 GPIO_ACTIVE_HIGH>;
	status = "okay";

	ethernet-phy-package@0 {
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;

		qcom,package-mode = "qusgmii";

		qca8084_0: ethernet-phy@0 {
			reg = <1>;
		};
		qca8084_1: ethernet-phy@1 {
			reg = <2>;
		};
		qca8084_2: ethernet-phy@2 {
			reg = <3>;
		};
		qca8084_3: ethernet-phy@3 {
			reg = <4>;
		};
	};

	qca8081_12: ethernet-phy@12 {
		reg = <12>;
	};
};

&tlmm {
	mdio_pins: mdio_pinmux {
		mux_0 {
			pins = "gpio38";
			function = "mdc";
			drive-strength = <8>;
			bias-disable;
		};
		mux_1 {
			pins = "gpio39";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qspi_nand_pins: qspi_nand_pins {
		qspi_clock {
			pins = "gpio5";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		qspi_cs {
			pins = "gpio4";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		qspi_data {
			pins = "gpio0", "gpio1", "gpio2", "gpio3";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qspi_nand_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;

		partitions {
			compatible = "qcom,smem-part";
		};
	};
};

&rpm_requests {
	regulators {
		compatible = "qcom,rpm-mp5496-regulators";

		ipq9574_s1: s1 {
			regulator-min-microvolt = <725000>;
			regulator-max-microvolt = <1075000>;
		};
	};
};

&dp1 {
	phy-handle = <&qca8084_0>;
	status = "okay";
	phy-mode = "usxgmii";
};

&dp2 {
	phy-handle = <&qca8084_1>;
	status = "okay";
	phy-mode = "usxgmii";
};

&dp3 {
	phy-handle = <&qca8084_2>;
	status = "okay";
	phy-mode = "usxgmii";
};

&dp4 {
	phy-handle = <&qca8084_3>;
	status = "okay";
	phy-mode = "usxgmii";
};

&dp5 {
	phy-handle = <&qca8081_12>;
	phy-mode = "usxgmii";
	status = "okay";
};

&edma {
	status = "okay";
};

&switch {
	switch_cpu_bmp = <0x1>;
	switch_lan_bmp = <0x1e>;
	switch_wan_bmp = <0x40>;
	switch_mac_mode = <0x15>;
	switch_mac_mode1 = <0xFF>;
	switch_mac_mode2 = <0xF>;
	bm_tick_mode = <0>;
	tm_tick_mode = <1>;

	qcom,port_phyinfo {
		port@0 {
			port_id = <1>;
			phy_address = <1>;
		};
		port@1 {
			port_id = <2>;
			phy_address = <2>;
		};
		port@2 {
			port_id = <3>;
			phy_address = <3>;
		};
		port@3 {
			port_id = <4>;
			phy_address = <4>;
		};
		port@4 {
			port_id = <6>;
			phy_address = <12>;
			port_mac_sel = "QGMAC_PORT";
		};
	};
};

&pcie2_phy {
	status = "okay";
};

&pcie2 {
	status = "okay";
	perst-gpios = <&tlmm 29 GPIO_ACTIVE_LOW>;
};

&pcie3_phy {
	status = "okay";
};

&pcie3 {
	status = "okay";
	#perst-gpios = <&tlmm 29 GPIO_ACTIVE_LOW>;
};

&blsp1_uart2 {
        pinctrl-0 = <&uart2_pins>;
        pinctrl-names = "default";
        status = "okay";
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-frequency = <24000000>;
};
